#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt {
    quick_tap_ms = <200>;
};

&mt {
    quick_tap_ms = <200>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
  &kp ESCAPE      &kp Q  &kp W     &kp E     &kp R  &kp T        &kp Y      &kp U  &kp I      &kp O     &kp P     &kp BSLH
  &kp LEFT_SHIFT  &kp A  &kp S     &kp D     &kp F  &kp G        &kp H      &kp J  &kp K      &kp L     &kp SEMI  &kp SQT
  &kp RCTRL       &kp Z  &kp X     &kp C     &kp V  &kp B        &kp N      &kp M  &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                         &kp LALT  &kp LGUI  &mo 2  &kp SPACE    &kp ENTER  &mo 1  &kp BSPC   &kp RGUI
            >;
        };

        arrow+numbers {
            bindings = <
  &kp GRAVE  &kp Q         &kp W      &kp E      &kp R          &kp T           &kp PAGE_UP    &kp U     &kp UP     &kp O      &kp P     &kp DELETE
  &kp TAB    &kp A         &kp S      &kp D      &kp F          &kp G           &kp PAGE_DOWN  &kp LEFT  &kp DOWN   &kp RIGHT  &kp SEMI  &kp SQT
  &kp RCTRL  &kp LS(PLUS)  &kp EQUAL  &kp MINUS  &kp LS(UNDER)  &kp LS(PIPE)    &kp N          &kp M     &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
                           &kp LALT   &kp LGUI   &mo 3          &kp SPACE       &kp ENTER      &trans    &kp BSPC   &kp RGUI
            >;
        };

        numbers {
            bindings = <
  &kp ESCAPE      &kp N1  &kp N2    &kp N3    &kp N4  &kp N5       &kp N6     &kp N7  &kp N8     &kp N9    &kp N0    &kp DEL
  &kp LEFT_SHIFT  &kp A   &kp S     &kp D     &kp F   &kp G        &kp H      &kp J   &kp K      &kp L     &kp SEMI  &kp SQT
  &kp RCTRL       &kp Z   &kp X     &kp C     &kp V   &kp B        &kp N      &kp M   &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                          &kp LALT  &kp LGUI  &trans  &kp SPACE    &kp ENTER  &trans  &kp BSPC   &kp RGUI
            >;
        };

        settings {
            bindings = <
  &kp ESC         &trans        &trans        &kp UP        &trans      &kp PRINTSCREEN    &kp F1   &kp F2  &kp F3    &kp F4    &kp F5   &kp F6
  &kp LEFT_SHIFT  &trans        &kp LEFT      &kp DOWN      &kp RIGHT   &kp PAGE_UP        &kp F7   &kp F8  &kp F9    &kp F10   &kp F11  &kp F12
  &kp RCTRL       &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &kp PAGE_DOWN      &trans   &trans  &trans    &trans    &trans   &trans
                                &kp LALT      &kp LGUI      &trans      &kp SPACE          &kp RET  &trans  &kp BSPC  &kp RGUI
            >;
        };
    };
};
