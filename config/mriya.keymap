#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    macros {
        raif_pass: raif_pass {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(N) &kp B &kp V &kp E &kp H &kp R &kp A &kp I &kp F &kp N2 &kp N6 &kp N0 &kp N9 &kp AMPS>;
            label = "RAIF_PASS";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            bindings = <
  &kp ESCAPE      &kp Q  &kp W     &kp E     &kp R  &kp T        &kp Y      &kp U  &kp I      &kp O     &kp P     &kp BSLH
  &kp LEFT_SHIFT  &kp A  &kp S     &kp D     &kp F  &kp G        &kp H      &kp J  &kp K      &kp L     &kp SEMI  &kp SQT
  &kp RCTRL       &kp Z  &kp X     &kp C     &kp V  &kp B        &kp N      &kp M  &kp COMMA  &kp DOT   &kp FSLH  &kp RSHFT
                         &kp LALT  &kp LGUI  &mo 2  &kp SPACE    &kp ENTER  &mo 1  &kp BSPC   &kp RGUI
            >;
        };

        arrow+numbers {
            bindings = <
  &kp GRAVE  &trans        &trans     &trans     &trans         &trans          &kp PAGE_UP    &trans    &kp UP    &trans     &trans  &kp DELETE
  &kp TAB    &trans        &trans     &trans     &trans         &trans          &kp PAGE_DOWN  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
  &trans     &kp LS(PLUS)  &kp EQUAL  &kp MINUS  &kp LS(UNDER)  &kp LS(PIPE)    &trans         &trans    &trans    &trans     &trans  &trans
                           &trans     &trans     &mo 3          &trans          &trans         &none     &trans    &trans
            >;
        };

        numbers {
            bindings = <
  &kp ESCAPE      &kp N1  &kp N2  &kp N3  &kp N4  &kp N5    &kp N6  &kp N7  &kp N8  &kp N9  &kp N0            &kp DEL
  &kp LEFT_SHIFT  &trans  &trans  &trans  &trans  &trans    &kp H   &kp J   &kp K   &kp L   &kp LEFT_BRACKET  &kp RIGHT_BRACKET
  &trans          &kp Z   &kp X   &kp C   &kp V   &kp B     &trans  &trans  &trans  &trans  &trans            &trans
                          &trans  &trans  &none   &trans    &trans  &mo 4   &trans  &trans
            >;
        };

        settings {
            bindings = <
  &kp ESC         &none  &none     &kp UP    &none      &kp PRINTSCREEN    &kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6
  &kp LEFT_SHIFT  &none  &kp LEFT  &kp DOWN  &kp RIGHT  &kp PAGE_UP        &kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12
  &kp RCTRL       &none  &none     &none     &none      &kp PAGE_DOWN      &none   &none   &none   &none    &none    &raif_pass
                         &trans    &trans    &none      &trans             &trans  &none   &trans  &trans
            >;
        };

        bluetooth {
            bindings = <
  &bt BT_NXT  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR  &studio_unlock    &none  &none  &none  &none  &none  &none
  &bt BT_PRV  &none         &none         &none         &none       &none             &none  &none  &none  &none  &none  &none
  &none       &none         &none         &none         &none       &none             &none  &none  &none  &none  &none  &none
                            &none         &none         &none       &none             &none  &none  &none  &none
            >;
        };
    };
};
